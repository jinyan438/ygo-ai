{
  "name": "ygo-ai",
  "version": "1.2.0",
  "description": "Yu-Gi-Oh AI toolkit over MCP: card data, deck management, verified OCG duel engine with persistent sessions, YGOPro2 bridge and replay analysis.",
  "private": true,
  "license": "0BSD",
  "type": "module",
  "main": "mcp/server.mjs",
  "bin": {
    "ygo-ai-mcp": "mcp/server.mjs"
  },
  "exports": {
    ".": "./mcp/server.mjs",
    "./lib": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "mcp",
    "lib",
    "skill",
    "patches",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "yugioh",
    "ygopro",
    "game-ai",
    "mcp",
    "model-context-protocol",
    "ocgcore",
    "duel-engine"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
